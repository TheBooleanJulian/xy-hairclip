{
  // xy-hairclip: number picker for the limited edition XYMIKU.39 hairclip.
  "name": "xy-hairclip",
  // accurova account (owns thebooleanjulian.dev). Moved off the xymiku39 account on
  // 2026-11-14: a zone rule on xymiku39.com served Notion for xy-hairclip.xymiku39.com.
  "account_id": "c580c4403524273d1bece674117472dd",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,

  // ./public is served without running the Worker; only /api/* runs it.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Per-IP limit on claims. namespace_id only has to be unique in the account.
  "ratelimits": [
    { "name": "RL_CLAIM", "namespace_id": "3901", "simple": { "limit": 5, "period": 60 } }
  ],

  // Secrets (set with `npx wrangler secret put NAME`, never committed):
  //   APPS_SCRIPT_URL  web app URL of apps-script/Code.gs (ends in /exec)
  //   SHEET_TOKEN      shared token, same value as the script's TOKEN property
  //   ADMIN_PASSCODE   passcode the claim form must send to write a name
  // Until the first two are set, /api/* answers 503 "Number picking opens soon."
  // Without ADMIN_PASSCODE, claims answer 503 "Claims are closed right now."
  // Set these as secrets (dashboard type "Secret"): plain-text dashboard vars are
  // wiped by the next `wrangler deploy`.

  "observability": { "enabled": true },

  // Production domain. The Cache API (10 s list cache) only works on custom domains.
  // Overrides the *.thebooleanjulian.dev wildcard A record to Zeabur for this host.
  "routes": [{ "pattern": "xy-hairclip.thebooleanjulian.dev", "custom_domain": true }]
}
